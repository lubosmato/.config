[global]
origin = bottom-right
offset = 30x10
corner_radius = 12
padding = 12
horizontal_padding = 16
notification_limit = 5
font = Sans 12

# Left click: open the notification's default action (e.g. open Telegram chat), then dismiss.
# Middle click: dismiss without acting. Right click: close all.
mouse_left_click = do_action, close_current
mouse_middle_click = close_current
mouse_right_click = close_all
width = 350
frame_width = 1
frame_color = "#ffffff80"
separator_color= frame
highlight = "#ffffff80"

[urgency_low]
background = "#000000aa"
foreground = "#ffffff"

[urgency_normal]
background = "#000000aa"
foreground = "#ffffff"

[urgency_critical]
background = "#000000aa"
foreground = "#ffffff"
frame_color = "#fab387"
