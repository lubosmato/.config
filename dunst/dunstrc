[global]
origin = bottom-right
offset = 30x10
corner_radius = 12
padding = 12
horizontal_padding = 16
notification_limit = 5
font = Sans 12
width = 350
frame_width = 1
frame_color = "#ffffff80"
separator_color= frame
highlight = "#ffffff80"

[urgency_low]
background = "#000000aa"
foreground = "#ffffff"

[urgency_normal]
background = "#000000aa"
foreground = "#ffffff"

[urgency_critical]
background = "#000000aa"
foreground = "#ffffff"
frame_color = "#fab387"
